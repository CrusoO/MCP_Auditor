# Lightweight image for the mock MCP server used in integration tests.
FROM python:3.12-slim

RUN addgroup --system --gid 1001 mock && \
    adduser  --system --uid 1001 --ingroup mock --no-create-home mock

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

RUN uv pip install --system fastapi "uvicorn[standard]" pydantic

COPY mock_server/ ./mock_server/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER mock

EXPOSE 8001

ENTRYPOINT ["uvicorn", "mock_server.server:app", \
            "--host", "0.0.0.0", \
            "--port", "8001", \
            "--log-level", "info"]
